{
  "name": "obama-discord-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A wake-word Discord voice and text conversation bot using OpenAI or Gemini with Cartesia TTS.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "bots": "node control-center/server.mjs",
    "test:control": "node --test control-center/test/*.test.mjs",
    "dev": "node --watch-path=src --watch-preserve-output scripts/run.mjs --dev",
    "build": "tsc -p tsconfig.json",
    "start": "node scripts/run.mjs",
    "test": "npm run build && node --test dist/test/*.test.js && npm run test:control",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "doctor": "npm run build && node dist/src/doctor.js"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.27.0",
    "dotenv": "^17.2.2",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.2"
  }
}
