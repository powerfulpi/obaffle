# Copy to .env.local. Use credentials from a LiveKit Cloud project.
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Use the Cartesia voice ID you are authorized to use.
LIVEKIT_PHONE_VOICE_ID=
LIVEKIT_PHONE_AGENT_NAME=obama-livekit-test
LIVEKIT_PHONE_GREETING=How can I help?
LIVEKIT_PHONE_INSTRUCTIONS=You are a friendly AI assistant called Obama. Keep phone answers brief and useful.
